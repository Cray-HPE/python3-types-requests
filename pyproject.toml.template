[build-system]
build-backend = "setuptools.build_meta"
requires = ["setuptools>=77.0.3"]

[project]
name = "types-requests"
version = "0.0.57"
license = "Apache-2.0"
license-files = ["LICENSE"]
description = "Typing stubs for requests"
readme = { text = """\
INSERT_DESCRIPTION_HERE
""", content-type = "text/markdown" }
classifiers = [
  "Programming Language :: Python :: 3",
  "Typing :: Stubs Only",
]
requires-python = ">=3.9"
dependencies = ['urllib3>=2']

[project.urls]
"Homepage" = "https://github.com/Cray-HPE/python3-types-requests"
"GitHub" = "https://github.com/Cray-HPE/python3-types-requests"
"Upstream" = "https://github.com/python/typeshed"
"Issue tracker" = "https://github.com/Cray-HPE/python3-types-requests/issues"

[tool.setuptools]
packages = ['requests-stubs']
include-package-data = false
